#!/usr/bin/env bash
#
# Mowzi pre-commit hook: enforce all tests pass before commit
# Installed via .githooks/ directory
#

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${YELLOW}[pre-commit] Running backend tests...${NC}"

cd backend
if python -m pytest tests/ -q --tb=short 2>&1; then
    BACKEND_COUNT=$(python -m pytest tests/ -q --co 2>&1 | tail -1 | grep -oP '\d+' | head -1)
    echo -e "${GREEN}[pre-commit] Backend tests passed ($BACKEND_COUNT tests)${NC}"
else
    echo -e "${RED}[pre-commit] Backend tests FAILED. Commit aborted.${NC}"
    exit 1
fi
cd ..

echo -e "${YELLOW}[pre-commit] Running Android unit tests...${NC}"

cd android
if ./gradlew testDebugUnitTest -q 2>&1; then
    echo -e "${GREEN}[pre-commit] Android tests passed${NC}"
else
    echo -e "${RED}[pre-commit] Android tests FAILED. Commit aborted.${NC}"
    exit 1
fi
cd ..

echo -e "${GREEN}[pre-commit] All tests passed. Commit allowed.${NC}"
exit 0
